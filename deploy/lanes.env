# Lane definitions for the git-ai (graft) deployment.
#
# Two lanes run on the same host and share nothing but the machine:
#
#   prod    the service that serves clients today. Its data lives in the
#           PostgreSQL database `gitai` and the RustFS bucket `git-ai-objects`.
#   staging the release lane. Its data lives in the PostgreSQL database
#           `gitai_staging`, the RustFS bucket `git-ai-objects-staging`, its
#           own role, its own token and its own ports. A test that writes to
#           staging cannot reach production's rows, objects or credentials.
#
# No secret lives in this file. The PostgreSQL password, the RustFS
# credentials and the server token live on the host, in 0600 files, and are
# generated on the first deploy of a lane.

DEPLOY_HOST="${DEPLOY_HOST:-oleNas01}"
DEPLOY_SSH_USER="${DEPLOY_SSH_USER:-oliveagle}"
DEPLOY_SSH_OPTS="${DEPLOY_SSH_OPTS:--o ConnectTimeout=10 -o BatchMode=yes}"
DEPLOY_HOME="${DEPLOY_HOME:-/home/oliveagle/opt}"
DEPLOY_BASE="${DEPLOY_BASE:-$DEPLOY_HOME/git-ai}"

# --- production lane -------------------------------------------------------
PROD_LANE_NAME="prod"
PROD_DIR="$DEPLOY_BASE"
PROD_GITALY_PORT="${PROD_GITALY_PORT:-8075}"
PROD_CACHE_TCP_PORT="${PROD_CACHE_TCP_PORT:-8076}"
PROD_CACHE_METRICS_PORT="${PROD_CACHE_METRICS_PORT:-9237}"
PROD_PG_DB="${PROD_PG_DB:-gitai}"
PROD_PG_USER="${PROD_PG_USER:-temporal}"
PROD_BUCKET="${PROD_BUCKET:-git-ai-objects}"
PROD_NODE_ID="${PROD_NODE_ID:-oleNas01}"
PROD_CONTAINER="git-ai-gitaly"
PROD_SUPERVISOR_PROGRAMS="git-ai-cache git-ai-cache-tcp"
# The ini that defines the lane's cache tiers. Production's file predates the
# lanes and is named without the lane; pointing the lane at it keeps one
# definition per program instead of a duplicate supervisor refuses to load.
PROD_SUPERVISOR_INI="git-ai.ini"

# --- staging lane ----------------------------------------------------------
STAGING_LANE_NAME="staging"
STAGING_DIR="${STAGING_DIR:-$DEPLOY_HOME/git-ai-staging}"
STAGING_GITALY_PORT="${STAGING_GITALY_PORT:-8175}"
STAGING_CACHE_TCP_PORT="${STAGING_CACHE_TCP_PORT:-8176}"
STAGING_CACHE_METRICS_PORT="${STAGING_CACHE_METRICS_PORT:-9337}"
STAGING_PG_DB="${STAGING_PG_DB:-gitai_staging}"
STAGING_PG_USER="${STAGING_PG_USER:-temporal_staging}"
STAGING_BUCKET="${STAGING_BUCKET:-git-ai-objects-staging}"
STAGING_NODE_ID="${STAGING_NODE_ID:-oleNas01-staging}"
STAGING_CONTAINER="git-ai-gitaly-staging"
STAGING_SUPERVISOR_PROGRAMS="git-ai-cache-staging git-ai-cache-staging-tcp"
STAGING_SUPERVISOR_INI="git-ai-staging.ini"

# The storage core both lanes use: PostgreSQL (Pigsty) and RustFS, both on
# the NAS itself.
PG_HOST="${PG_HOST:-127.0.0.1}"
PG_PORT="${PG_PORT:-15432}"
PG_SUPERUSER="${PG_SUPERUSER:-postgres}"
PG_CONTAINER="${PG_CONTAINER:-pigsty-postgres}"
PG_IN_CONTAINER_PORT="${PG_IN_CONTAINER_PORT:-25432}"
RUSTFS_ENDPOINT="${RUSTFS_ENDPOINT:-http://127.0.0.1:9000}"
RUSTFS_REGION="${RUSTFS_REGION:-us-east-1}"
RUSTFS_CONTAINER="${RUSTFS_CONTAINER:-rustfs}"
